// Windows version resource for NV3D-Glass (fork build).
//
// The executable carried NO version information before this file: Windows
// shows an empty "Details" tab and reputation heuristics score an anonymous
// binary worse. Keep FILEVERSION/PRODUCTVERSION in sync with the git tag
// (currently v1.0.0).
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NeoGamingVibes"
            VALUE "FileDescription", "NV3D-Glass - 3D Vision stereo capture companion (fork)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "NV3D-Glass"
            VALUE "LegalCopyright", "Copyright (C) 2026 OneUp (oneup03). Fork modifications (C) 2026 NeoGamingVibes."
            VALUE "OriginalFilename", "NV3D-Glass.exe"
            VALUE "ProductName", "NV3D-Glass"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Comments", "https://github.com/neogamingvibes/NV3D-Glass-3DVision"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
